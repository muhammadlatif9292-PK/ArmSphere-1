# Stage 1: Build
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root package files
COPY package.json package-lock.json ./

# Copy apps and packages
COPY apps/admin-web ./apps/admin-web
COPY packages ./packages

# Install and build
RUN npm ci && npm run build --workspace=@armsphere/admin-web

# Stage 2: Serve with nginx
FROM nginx:alpine

# Copy nginx config
COPY nginx.conf /etc/nginx/nginx.conf

# Copy built admin-web from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Create app user
RUN addgroup -g 1001 -S nginx && adduser -S nginx -u 1001 -D

USER nginx

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/index.html || exit 1

EXPOSE 80

LABEL org.opencontainers.image.title="ArmSphere Admin Web" \
      org.opencontainers.image.description="Competitive arm wrestling championship platform admin dashboard" \
      org.opencontainers.image.version="1.0.0"
