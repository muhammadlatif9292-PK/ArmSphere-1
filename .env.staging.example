# ==============================================================================
#             ARMSPHERE ISOLATED STAGING ENVIRONMENT TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. In your Neon Console (https://console.neon.tech), create a new branch named 'staging'
#    from the 'main' branch (or create an empty branch).
# 2. Copy the pooled connection string into DATABASE_URL below.
# 3. Copy the direct (unpooled) connection string into DATABASE_URL_UNPOOLED.
# 4. Copy this file to '.env.staging' (strictly gitignored).
# 5. Run migrations: npm run db:migrate
# 6. Seed staging fixtures: npm run db:seed:staging
# ==============================================================================

# Core Staging Flags (Hard Invariant: NEON_BRANCH MUST NOT be 'main' or 'production')
NODE_ENV=staging
NEON_BRANCH=staging
PORT=4000

# Isolated Neon Staging Database (Replace with your actual Neon staging branch endpoint)
DATABASE_URL=postgresql://staging_user:STAGING_PASSWORD_HERE@ep-staging-sample-12345678-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://staging_user:STAGING_PASSWORD_HERE@ep-staging-sample-12345678.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Session Secrets (Staging isolated)
JWT_ACCESS_SECRET=staging_super_secret_armsphere_access_jwt_key_32bytes_minimum_length
JWT_REFRESH_SECRET=staging_super_secret_armsphere_refresh_jwt_key_32bytes_minimum_length
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CRON_SECRET=staging_cron_secret_armsphere_1234567890

# Storage & Buckets (Isolated staging buckets)
STORAGE_PROVIDER=b2
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET_COMPLIANCE_DOCS=compliance-docs-staging
B2_BUCKET_ATHLETE_AVATARS=athlete-avatars-staging

# Federation Sanction Certificate Service (Staging endpoint)
FEDERATION_CERT_SERVICE_URL=https://staging-cert-service.armsphere.workers.dev
FEDERATION_CERT_API_KEY=staging_test_api_key_cert_service
FEDERATION_CERT_SIGNING_KEY_ID=staging_key_2026_01

# CORS
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
