# Environment Variables Example File
# Copy this file to .env and replace placeholder values with your actual secrets

# ==============================================================================
# Required Database Configuration
# ==============================================================================
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================================================
# Authentication & Security
# ==============================================================================
JWT_SECRET=your-jwt-secret-key-here
REFRESH_TOKEN_SECRET=your-refresh-token-secret-key-here
ENCRYPTION_KEY=your-encryption-key-here

# ==============================================================================
# Firebase Configuration (if using Firebase services)
# ==============================================================================
FIREBASE_API_KEY=your-firebase-api-key-here
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-storage-bucket
FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# ==============================================================================
# Stripe Payment Integration
# ==============================================================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret-here
STRIPE_API_VERSION=2024-06-20

# ==============================================================================
# Email Services (if using email for notifications)
# ==============================================================================
SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@armsphere.app
RESEND_API_KEY=your-resend-api-key-here

# ==============================================================================
# SMS Services (if using SMS for notifications)
# ==============================================================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid-here
TWILIO_AUTH_TOKEN=your-twilio-auth-token-here
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================================================
# External APIs
# ==============================================================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
OPENWEATHER_API_KEY=your-openweather-api-key-here
MAPBOX_ACCESS_TOKEN=pk_your-mapbox-access-token-here

# ==============================================================================
# Third-party Services
# ==============================================================================
KAFKA_BOOTSTRAP_SERVERS=your-kafka-bootstrap-servers-here
REDIS_URL=redis://localhost:6379
POSTGRES_URL=your-postgres-connection-string-here

# ==============================================================================
# Application Configuration
# ==============================================================================
APP_ENV=development
APP_PORT=3000
NODE_ENV=development
CORS_ORIGIN=https://localhost:3000

# ==============================================================================
# Logging & Monitoring
# ==============================================================================
LOG_LEVEL=info
SENTRY_DSN=https://your-sentry-dsn-here
DATADOG_API_KEY=your-datadog-api-key-here

# ==============================================================================
# File Storage
# ==============================================================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id-here
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key-here
AWS_S3_BUCKET_NAME=your-aws-s3-bucket-name-here
AWS_REGION=us-east-1

# ==============================================================================
# Social Media & Analytics
# ==============================================================================
FACEBOOK_APP_ID=your-facebook-app-id-here
GOOGLE_CLIENT_ID=your-google-client-id-here
META_PIXEL_ID=your-meta-pixel-id-here

# ==============================================================================
# Admin & System Configuration
# ==============================================================================
ADMIN_EMAIL=admin@armsphere.app
SYSTEM_EMAIL=noreply@armsphere.app
SUPPORT_EMAIL=support@armsphere.app
COMPANY_NAME=ArmSphere
COMPANY_ADDRESS=123 Main Street, City, Country

# ==============================================================================
# Security Headers
# ==============================================================================
CSRF_SECRET=your-csrf-secret-key-here
SESSION_SECRET=your-session-secret-key-here
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ==============================================================================
# Features Flags (Optional)
# ==============================================================================
ENABLE_FEATURE_FLAG_NAME=true
DISABLE_FEATURE_FLAG_NAME=false

# ==============================================================================
# Database Configuration (for direct database connections)
# ==============================================================================
DATABASE_URL=postgresql://username:password@localhost:5432/armsphere_db
DATABASE_URL_TEST=postgresql://username:password@localhost:5432/armsphere_test

# ==============================================================================
# Feature Flags and Environment Settings
# ==============================================================================
# Add your specific application feature flags below

# App Configuration
APP_NAME=ArmSphere
APP_VERSION=1.0.0
DEBUG_MODE=true

# Feature Flags
ENABLE_PROVINCIAL_JURISDICTION=true
ENABLE_ROLE_BASED_ROUTING=true
ENABLE_WEB_BUILD_VERIFICATION=true
ENABLE_ANDROID_RELEASE_BUILD=true
ENABLE_IOS_DEVELOPMENT=true

# ==============================================================================
# Phase 13 Specific Environment Variables
# ==============================================================================
# Provincial Jurisdiction Configuration
PROVINCIAL_JURISDICTION_ENABLED=true
PROVINCIAL_DIRECTOR_PROVINCE_VALIDATION=true

# Role-Based Routing Configuration
ROLE_BASED_ROUTING_ENABLED=true
REFETCH_USER_ROLE_ON_AUTH=true

# Web Build Configuration
FLUTTER_WEB_BUILD_ENABLED=true
WEBVIEW_FLAVOR=development
WEBVIEW_STUBS_ENABLED=true

# Android Release Configuration
ANDROID_RELEASE_KEYSTORE_PATH=./android/app/debug.keystore
ANDROID_RELEASE_KEY_ALIAS=debug
ANDROID_RELEASE_KEY_PASSWORD=armsphere123
ANDROID_RELEASE_STORE_PASSWORD=armsphere123

# iOS Development Configuration
IOS_BUNDLE_IDENTIFIER=com.armsphere.mobile
IOS_DEVELOPMENT_TEAM=your-development-team-id
IOS_PUSH_NOTIFICATIONS_ENABLED=true

# E2E Testing Configuration
E2E_TEST_MODE=true
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=testpassword123
TEST_PROVINCIAL_DIRECTOR_EMAIL=pd@example.com
TEST_PROVINCIAL_DIRECTOR_PASSWORD=pdpassword123

# ==============================================================================
# Firebase Configuration (if using Firebase for authentication)
# ==============================================================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
FIREBASE_PRIVATE_KEY_PATH=firebase-service-account.json
FIREBASE_DATABASE_URL=https://your-database-url.firebaseio.com

# ==============================================================================
# Stripe Configuration (for payments and subscriptions)
# ==============================================================================
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key-here
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_ACCOUNT_ID=your-stripe-account-id
STRIPE_SUCCESS_URL=https://armsphere.app/payment-success
STRIPE_CANCEL_URL=https://armsphere.app/payment-cancel

# ==============================================================================
# Security & Session Management
# ==============================================================================
SESSION_TIMEOUT_MINUTES=30
PASSWORD_MIN_LENGTH=8
REQUIRE_SPECIAL_CHAR_IN_PASSWORD=true
REQUIRE_NUMBER_IN_PASSWORD=true
REQUIRE_UPPERCASE_IN_PASSWORD=true

# ==============================================================================
# Rate Limiting
# ==============================================================================
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS_PER_IP=100
RATE_LIMIT_MAX_REQUESTS_PER_USER=1000

# ==============================================================================
# Logging Configuration
# ==============================================================================
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_FILE_SIZE_MB=10
LOG_MAX_FILES=5

# ==============================================================================
# External Service Endpoints
# ==============================================================================
API_BASE_URL=https://api.armsphere.app
WEBSOCKET_URL=wss://api.armsphere.app/ws
WEBSOCKET_RECONNECT_INTERVAL_MS=5000

# ==============================================================================
# File Upload Configuration
# ==============================================================================
MAX_FILE_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,gif
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,txt

# ==============================================================================
# Notification Configuration
# ==============================================================================
PUSH_NOTIFICATION_ENABLED=true
EMAIL_NOTIFICATION_ENABLED=true
SMS_NOTIFICATION_ENABLED=true
PUSH_NOTIFICATION_PROVIDER=firebase
EMAIL_NOTIFICATION_PROVIDER=smtp
SMS_NOTIFICATION_PROVIDER=twilio

# ==============================================================================
# Cache Configuration
# ==============================================================================
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_EXPIRY_SECONDS=3600

# ==============================================================================
# Analytics & Monitoring
# ==============================================================================
ANALYTICS_PROVIDER=google_analytics
ANALYTICS_TRACKING_ID=your-google-analytics-tracking-id
ANALYTICS_SAMPLE_RATE=100
DEBUG_ANALYTICS=true

# ==============================================================================
# Offline Sync Configuration
# ==============================================================================
OFFLINE_SYNC_ENABLED=true
OFFLINE_SYNC_QUEUE_SIZE=1000
OFFLINE_SYNC_RETRY_ATTEMPTS=3
OFFLINE_SYNC_RETRY_DELAY_MS=5000

# ==============================================================================
# Differential Sync Configuration
# ==============================================================================
DIFF_SYNC_ENABLED=true
DIFF_SYNC_BATCH_SIZE=50
DIFF_SYNC_CONCURRENCY_LIMIT=5
DIFF_SYNC_TIMEOUT_MS=30000

# ==============================================================================
# Security Headers
# ==============================================================================
CSP_HEADER=default-src 'self'
HSTS_HEADER=31536000
X_FRAME_OPTIONS_HEADER=Deny
X_CONTENT_TYPE_OPTIONS_HEADER=nosniff
X_XSS_PROTECTION_HEADER=1; mode=block

# ==============================================================================
# Notification Configuration
# ==============================================================================
FCM_SERVER_KEY=your-fcm-server-key-here
PUSH_NOTIFICATION_SOUND=notification.wav
PUSH_NOTIFICATION_VIBRATION=true

# ==============================================================================
# Phase 13 Compliance Variables
# ==============================================================================
# Required for Phase 13 compliance documentation
PROVINCIAL_JURISDICTION_ENFORCED=true
ROLE_BASED_ROUTING_IMPLEMENTED=true
E2E_JOURNEYS_TESTED=true
WEB_BUILD_VERIFIED=true
ANDROID_RELEASE_CONFIGURED=true
IOS_PROJECT_READY=true
SECRET_HYGIENE_ESTABLISHED=true

# ==============================================================================
# Backup & Recovery
# ==============================================================================
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=your-backup-encryption-key