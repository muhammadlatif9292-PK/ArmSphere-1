# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE & BACKEND INFRASTRUCTURE
# For local development: postgresql://armsphere:armsphere_password@localhost:5432/armsphere
# For production: Neon PostgreSQL connection string (postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require)
IS_SERVERLESS="false"
CRON_SECRET="REPLACE_WITH_RANDOM_CRON_SECRET"
DATABASE_URL="postgresql://armsphere:armsphere_password@localhost:5432/armsphere"

JWT_ACCESS_SECRET="super_secret_armsphere_access_jwt_key_with_length_greater_than_32"
JWT_REFRESH_SECRET="super_secret_armsphere_refresh_jwt_key_with_length_greater_than_32"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

STORAGE_PROVIDER="b2"
B2_ENDPOINT="s3.us-west-004.backblazeb2.com"
B2_REGION="us-west-004"
B2_ACCESS_KEY_ID=""
B2_SECRET_ACCESS_KEY=""
B2_BUCKET_COMPLIANCE_DOCS="compliance-docs"
B2_BUCKET_ATHLETE_AVATARS="athlete-avatars"
GCP_PROJECT_ID=

CORS_ORIGIN="http://localhost:3000"

# PRODUCTION HARDENING & METRICS (RECOMMENDED)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
APP_ENV="production"
LOG_LEVEL="info"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"

# COMMUNICATIONS & INTEGRATIONS (SMTP)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE="true"
SMTP_FROM_EMAIL="noreply@armsphere.com"

# MOBILE STORES CONFIGURATION
GOOGLE_PLAY_SERVICE_ACCOUNT=
APPLE_APP_STORE_CONNECT_KEY=

# SOCIAL AUTHENTICATION (Phase B)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# BOT & ABUSE PREVENTION (Phase C)
CAPTCHA_SECRET_KEY=

# FIREBASE CLOUD MESSAGING (FCM) CONFIGURATION
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# APPLE PUSH NOTIFICATION SERVICE (APNS) CONFIGURATION
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRIVATE_KEY=
APNS_SANDBOX="true"

# STRIPE PAYMENT GATEWAY CONFIGURATION
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


