# ==============================================================================
# ArmSphere Production Environment Variables Template
# ==============================================================================
# Save a copy of this file as '.env.production' in the root directory.
# NEVER commit the actual '.env.production' file containing secrets to version control.
# ==============================================================================

# Database Settings (Neon PostgreSQL)
# Must be an external pooled PostgreSQL connection string (e.g. Neon PostgreSQL)
DATABASE_URL=postgresql://USER:PASSWORD@ep-example.region.aws.neon.tech/neondb?sslmode=require

# Object Storage Settings (Backblaze B2)
STORAGE_PROVIDER=b2
B2_ENDPOINT=s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_ACCESS_KEY_ID=your_b2_access_key_id
B2_SECRET_ACCESS_KEY=your_b2_secret_access_key
B2_BUCKET_COMPLIANCE_DOCS=compliance-docs
B2_BUCKET_ATHLETE_AVATARS=athlete-avatars

# JWT Authentication Secrets
# Generates and validates cryptographic signatures for user sessions.
# MUST be at least 32 characters long.
JWT_ACCESS_SECRET=your_ultra_secure_jwt_access_secret_with_32_chars_or_more
JWT_REFRESH_SECRET=your_ultra_secure_jwt_refresh_secret_with_32_chars_or_more

# Internal CRON & Webhook Security
# Secures automated background workers and scheduled jobs (/admin/scheduled-jobs/run)
CRON_SECRET=your_ultra_secure_cron_secret_with_32_chars_or_more

# Server Runtime & CORS
PORT=3000
CORS_ORIGIN=https://armsphere.com,https://admin.armsphere.com

# Bot Mitigation (Cloudflare Turnstile - Free Tier)
# CAPTCHA_SECRET_KEY=0x4AAAAAA...

# Payment Processing (Stripe - Pay-as-you-go)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Push Notifications (Firebase Cloud Messaging - Free Tier)
# FIREBASE_PROJECT_ID=armsphere-production
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@armsphere-production.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

